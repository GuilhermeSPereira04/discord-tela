# Token do Bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=seu_token_aqui

# Application ID / Client ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=seu_client_id_aqui

# ID do seu Servidor do Discord (Clique direito no ícone do servidor -> Copiar ID do servidor)
GUILD_ID=id_do_seu_servidor_aqui
