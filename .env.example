# Usado só pelo "npm run register" (registro do /tela). O Worker não lê este arquivo:
# na Cloudflare, salve o token com "npx wrangler secret put DISCORD_TOKEN".

# Token do Bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=seu_token_aqui

# Application ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=seu_client_id_aqui
